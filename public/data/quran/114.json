{"n":114,"basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","basmalahTr":"বিসমিল্লাহির রাহমানির রাহীম","ayahs":[{"a":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","arPlain":"قل أعوذ برب الناس","tr":"কুল আঊযু বিরাব্বিন নাস","bn":"হে রাসূল! বলো: ‘আমি আশ্রয় চাই মানুষের রবের কাছে,","juz":30,"page":604},{"a":2,"ar":"مَلِكِ ٱلنَّاسِ","arPlain":"ملك الناس","tr":"মালিকিন নাস","bn":"(আশ্রয় চাই) মানুষের অধিপতির কাছে,","juz":30,"page":604},{"a":3,"ar":"إِلَـٰهِ ٱلنَّاسِ","arPlain":"إله الناس","tr":"ইলাহিন নাস","bn":"(আশ্রয় চাই) মানুষের ইলাহ’র (সত্য উপাস্যের) কাছে,","juz":30,"page":604},{"a":4,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","arPlain":"من شر الوسواس الخناس","tr":"মিন শার্‌রিল ওয়াসওয়াসিল খান্নাস","bn":"(আরও আশ্রয় চাই) কুমন্ত্রণাদাতা শয়তানের অনিষ্ট থেকে, যে (কুমন্ত্রণা দিয়ে) দ্রুত আত্মগোপন করে।","juz":30,"page":604},{"a":5,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","arPlain":"الذي يوسوس في صدور الناس","tr":"আল্লাযী ইউওয়াসউইসু ফী সুদূরিন নাস","bn":"যে মানুষের অন্তরে কুমন্ত্রণা দেয়,","juz":30,"page":604},{"a":6,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","arPlain":"من الجنة والناس","tr":"মিনাল জিন্নাতি ওয়ান্নাস","bn":"(মানুষের অন্তরে কুমন্ত্রণা দানকারী শয়তান) জিনদের মধ্য থেকেও হতে পারে এবং মানুষের মধ্য থেকেও।’","juz":30,"page":604}]}