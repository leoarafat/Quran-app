{"n":107,"basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","basmalahTr":"বিসমিল্লাহির রাহমানির রাহীম","ayahs":[{"a":1,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","arPlain":"أرأيت الذي يكذب بالدين","tr":"আরাআইতাল্লাযী ইউকায্‌যিবু বিদ্দীন","bn":"তুমি কি তাকে দেখেছ, যে বিচার দিবসের প্রতিদানকে অস্বীকার করে?","juz":30,"page":602},{"a":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","arPlain":"فذلك الذي يدع اليتيم","tr":"ফাযালিকাল্লাযী ইয়াদু’উল ইয়াতীম","bn":"সে তো ওই ব্যক্তি, যে ইয়াতীমকে (গলা ধাক্কা দিয়ে) রূঢ়ভাবে তাড়িয়ে দেয়,","juz":30,"page":602},{"a":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","arPlain":"ولا يحض على طعام المسكين","tr":"ওয়ালা ইয়াহুদ্দু আলা তাআমিল মিসকীন","bn":"আর সে মিসকীনকে খাদ্যদানে উৎসাহিত করে না।","juz":30,"page":602},{"a":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّينَ","arPlain":"فويل للمصلين","tr":"ফাওয়াইলুল লিলমুসাল্লীন","bn":"অতএব সেই সালাত আদায়কারীদের জন্য দুর্ভোগ,","juz":30,"page":602},{"a":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","arPlain":"الذين هم عن صلاتهم ساهون","tr":"আল্লাযীনা হুম আন সালাতিহিম সাহূন","bn":"যারা নিজেদের সালাত সম্পর্কে উদাসীন,","juz":30,"page":602},{"a":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","arPlain":"الذين هم يراءون","tr":"আল্লাযীনা হুম ইউরাঊন","bn":"যারা লোক দেখানোর জন্য তা করে,[১]","fn":"[১] অর্থাৎ লোক দেখানোর জন্যে সালাত আদায় ও নেক আমলসমূহ করে, আল্লাহর সন্তুষ্টির উদ্দেশ্যে করে না।","juz":30,"page":602},{"a":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","arPlain":"ويمنعون الماعون","tr":"ওয়াইয়ামনাঊনাল মাঊন","bn":"এবং ছোট-খাট গৃহসামগ্রী প্রদান করতে বিরত থাকে।","juz":30,"page":602}]}